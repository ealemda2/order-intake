# Copy to .env (never commit .env). Loaded by `node --env-file-if-exists` in the scripts.
ANTHROPIC_API_KEY=
# LangSmith tracing of the app's own LLM calls (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=order-intake
# Synthetic data only, but keep the habit: hide raw document text in traces
LANGSMITH_HIDE_INPUTS=false
